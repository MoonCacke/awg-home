{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "address": "<SERVER_IP_OR_NAME>",
        "port": 443,
        "id": "<CLIENT_UUID>",
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "<REALITY_SNI>",
          "fingerprint": "chrome",
          "password": "<REALITY_PUBLIC_KEY>",
          "shortId": "<SHORT_ID>",
          "spiderX": "/"
        }
      }
    }
  ]
}
